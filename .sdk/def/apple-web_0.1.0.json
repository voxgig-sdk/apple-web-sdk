          },
          "small2x": {
            "type": "string"
          },
          "medium": {
            "type": "string"
          },
          "medium2x": {
            "type": "string"
          },
          "large": {
            "type": "string"
          },
          "large2x": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "Article": {
        "type": "object",
        "description": "An Apple Newsroom article listed in a category.",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "description": "e.g. `PHOTOS`, `UPDATE`."
          },
          "date": {
            "type": "string",
            "description": "Display date, e.g. `September 18, 2026`."
          },
          "publishedTime": {
            "type": "integer",
            "format": "int64",
            "description": "Publication time in epoch milliseconds."
          },
          "link": {
            "type": "string",
            "description": "Absolute article URL."
          },
          "image": {
            "type": "object",
            "description": "Tile images by layout.",
            "properties": {
              "wide": {
                "$ref": "#/components/schemas/ImageSizes"
              },
              "hero-highlight": {
                "$ref": "#/components/schemas/ImageSizes"
              }
            },
            "additionalProperties": true
          }
        },
        "required": [
          "title",
          "description",
          "category",
          "date",
          "publishedTime",
          "link",
          "image"
        ],
        "additionalProperties": true
      },
      "Geoswitcher": {
        "type": "object",
        "description": "Country and locale data for the Apple Careers site switcher.",
        "properties": {
          "regions": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "A careers region. Each item also carries its name under the key `region label` (with a space), e.g. `Africa, Middle East, and India`; it is left out of the declared properties because a key with a space is not a valid field name in every SDK language, and passes through as an additional property.",
              "properties": {
                "countries": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Country"
                  }
                }
              },
              "required": [
                "countries"
              ],
              "additionalProperties": true
            }
          },
          "localeBasedLabels": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "locale": {
                  "type": "string",
                  "description": "e.g. `cs-cz`."
                },
                "country": {
                  "type": "string"
                },
                "barHeadline": {
                  "type": "string"
                },
                "closeButtonLabel": {
                  "type": "string"
                },
                "cta": {
                  "type": "string"
                },
                "currentlyViewing": {
                  "type": "string"
                },
                "modalHeadline": {
                  "type": "string",
                  "description": "Present on one locale only."
                }
              },
              "required": [
                "locale",
                "country",
                "barHeadline",
                "closeButtonLabel",
                "cta",
                "currentlyViewing"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "regions",
          "localeBasedLabels"
        ],
        "additionalProperties": true
      },
      "Country": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Country name, e.g. `Egypt`."
          },
          "lang": {
            "type": "string",
            "description": "Locale tag, e.g. `en-EG`."
          },
          "locale": {
            "type": "string",
            "description": "Careers path, e.g. `/careers/eg/`."
          }
        },
        "required": [
          "label",
          "lang",
          "locale"
        ],
        "additionalProperties": true
      }
    }
  }
}
